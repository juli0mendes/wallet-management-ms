{
  "info": {
    "_postman_id": "d8bd0635-e91e-4ddd-b891-0bf5f53c9ab8",
    "name": "Wallet Management MS - Functional Tests",
    "description": "Collection para testes funcionais manuais dos endpoints de carteira e transferencia.\n\nFluxo sugerido:\n1) Criar carteira origem\n2) Criar carteira destino\n3) Depositar na origem\n4) Transferir da origem para destino\n5) Consultar saldo e transacoes\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Create Wallet (Source)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.wallet_id) {",
                  "  pm.collectionVariables.set('sourceWalletId', json.wallet_id);",
                  "  pm.collectionVariables.set('walletId', json.wallet_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_name\": \"Source User\",\n  \"owner_email\": \"source.user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets"
              ]
            },
            "description": "Cria carteira de origem e salva o wallet_id em sourceWalletId e walletId."
          }
        },
        {
          "name": "Create Wallet (Destination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.wallet_id) {",
                  "  pm.collectionVariables.set('destinationWalletId', json.wallet_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_name\": \"Destination User\",\n  \"owner_email\": \"destination.user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets"
              ]
            },
            "description": "Cria carteira de destino e salva o wallet_id em destinationWalletId."
          }
        },
        {
          "name": "Get Wallet By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{walletId}}"
              ]
            },
            "description": "Consulta detalhes da carteira usando walletId (por padrao, a de origem)."
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{walletId}}",
                "balance"
              ]
            }
          }
        },
        {
          "name": "Get Balance At Timestamp",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/balance?at={{atTimestamp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{walletId}}",
                "balance"
              ],
              "query": [
                {
                  "key": "at",
                  "value": "{{atTimestamp}}"
                }
              ]
            },
            "description": "Consulta saldo em um instante especifico (LocalDateTime, ex.: 2026-03-30T21:40:00)."
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{walletId}}",
                "transactions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        {
          "name": "Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.transaction_id) {",
                  "  pm.collectionVariables.set('lastTransactionId', json.transaction_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"description\": \"Initial funding\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{sourceWalletId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{sourceWalletId}}",
                "deposit"
              ]
            }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 20.00,\n  \"description\": \"Cashout test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{sourceWalletId}}/withdraw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{sourceWalletId}}",
                "withdraw"
              ]
            }
          }
        },
        {
          "name": "Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.transfer_id) {",
                  "  pm.collectionVariables.set('lastTransferId', json.transfer_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_wallet_id\": \"{{sourceWalletId}}\",\n  \"destination_wallet_id\": \"{{destinationWalletId}}\",\n  \"amount\": 15.50,\n  \"description\": \"Transfer test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            }
          }
        }
      ]
    },
